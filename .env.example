# ============================================================
# FINANCIAL DOCTOR (finX) — Environment Configuration
# ============================================================

# Supabase (PostgreSQL + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (AI Model Gateway)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# Standby Fallback: google/gemini-2.0-flash-001 or mistralai/mistral-7b-instruct:free

# External Market & News Providers (Optional - high fidelity demo fallback provided)
MARKET_API_KEY=
# GNews.io free tier: https://gnews.io/ (100 requests/day free)
GNEWS_API_KEY=
EMBEDDING_API_KEY=
